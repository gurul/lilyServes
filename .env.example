# --- Required ---------------------------------------------------------------
OPENAI_API_KEY=sk-...
PROJECT_ID=heylily                      # Google Cloud project for Speech-to-Text V2
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json  # or use gcloud ADC

# --- Call routing -----------------------------------------------------------
FORWARD_TO=+15551234567                 # number calls are bridged to (required to bridge)
SCREEN_UNKNOWN_CALLERS=true             # Lily answers unknown/restricted callers first
TRUSTED_NUMBERS=+15550001111,+15550002222   # always ring straight through
AUTO_INTERVENE=false                    # true: hang up High-risk calls via Twilio REST

# --- Twilio (enables webhook auto-config + signature validation) ------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Optional providers ------------------------------------------------------
HIVE_API_SECRET=                        # deepfake detection; skipped if unset

# --- Security ----------------------------------------------------------------
CLIENT_TOKEN=                           # shared secret for /ws/client and /api/*; unset = open (dev)

# --- Privacy -----------------------------------------------------------------
RETAIN_TRANSCRIPTS=false                # persist full transcripts (redacted) in SQLite
SHARE_TRANSCRIPTS=true                  # stream transcript text to family dashboard

# --- Deployment ---------------------------------------------------------------
PORT=8000
PUBLIC_URL=                             # set when deployed behind a real domain; disables ngrok
NGROK_ENABLED=true                      # dev tunnel when PUBLIC_URL is unset
DATA_DIR=data                           # SQLite location
LOG_LEVEL=INFO

# --- Models (defaults shown) --------------------------------------------------
SCAM_MODEL=gpt-4o-mini
SUMMARY_MODEL=gpt-4o
EVENT_MODEL=gpt-4o-mini
