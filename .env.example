# Scam scoring (gpt-4o-mini) and post-call summary (gpt-4o)
OPENAI_API_KEY=

# Google Cloud project with the Speech-to-Text V2 API enabled
PROJECT_ID=heylily
# Service-account JSON path. Omit if you authenticated with `gcloud auth application-default login`
GOOGLE_APPLICATION_CREDENTIALS=

# Optional: auto-configures the voice webhook on your first Twilio number at boot
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Optional: Hive AI deepfake detection. Skipped when unset
HIVE_API_SECRET=

# Number the incoming call is bridged to
FORWARD_TO=

# Server port
PORT=8000
